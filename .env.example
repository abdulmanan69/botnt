# Phantom C2 - environment template for Coolify
#
# Coolify already pre-fills every one of these in the service's
# "Environment Variables" tab (they come from docker-compose.yml), so you can
# simply deploy. Use this file when you want to bulk-paste a full set:
#   Environment Variables -> "Developer view" / paste box -> paste -> Save.
#
# Rules of thumb:
#   * leave a value empty to have it generated at boot (auth, PSK) or
#     auto-detected (public URL) - that is the recommended default;
#   * never change PHANTOM_DATA / PHANTOM_BUILDS away from /data, or the PSK and
#     every artifact are lost on the next redeploy;
#   * keep PHANTOM_HOST=0.0.0.0 and PHANTOM_TLS=false behind the Coolify proxy.
#
# Generate strong secrets with:  openssl rand -hex 32   (PSK, 64 hex chars)

# ---- listener -------------------------------------------------------------
PHANTOM_HOST=0.0.0.0
PHANTOM_PORT=80
PHANTOM_TLS=false
PHANTOM_CERT=/app/server/certs/server.crt
PHANTOM_KEY=/app/server/certs/server.key
PHANTOM_LOG=info

# ---- credentials (empty = generated on first boot and printed in the logs) --
PHANTOM_AUTH=
PHANTOM_PSK=
PHANTOM_DEFAULT_PSK=false

# ---- storage --------------------------------------------------------------
PHANTOM_DATA=/data
PHANTOM_BUILDS=/data/builds
PHANTOM_CONFIG=/app/server/config.yaml

# ---- callback url / artifacts --------------------------------------------
# PHANTOM_PUBLIC_URL is optional: empty derives https://<your domain> from the
# incoming dashboard request, which is what you normally want.
PHANTOM_PUBLIC_URL=
PHANTOM_GO=go
PHANTOM_VENDOR=Microsoft Corporation
PHANTOM_ENCRYPT=true
PHANTOM_METADATA=true
PHANTOM_GARBLE=false
PHANTOM_UPX=false
PHANTOM_SIGN_PFX=
PHANTOM_SIGN_PASS=

# ---- SOCKS pivot ----------------------------------------------------------
PHANTOM_SOCKS=true
PHANTOM_SOCKS_HOST=127.0.0.1
PHANTOM_SOCKS_PORT=1080

# ---- build-time (compose build args, rebuild required) --------------------
INSTALL_GARBLE=0
INSTALL_UPX=0
